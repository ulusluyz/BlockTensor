#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer InBuffer { float in_data[]; };
layout(std430, binding = 1) readonly buffer ScaleBuffer { float scale_data[]; };
layout(std430, binding = 2) writeonly buffer OutBuffer { float out_data[]; };

layout(push_constant) uniform PushConstants { uint dim; } params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.dim) return;

    out_data[idx] = in_data[idx] * scale_data[idx];
}
